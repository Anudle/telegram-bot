TOKEN=telegram-bot-token           # main chatty bot (gifs, insults, stocks, etc.)
BIRTHDAY_BOT_TOKEN=                # optional: e.g. @kids_birthday_bot, posts birthdays in the dad chat
SCORE_BOT_TOKEN=                   # optional: e.g. @final_score_bot, posts finals in the football chat
DAD_CHAT_ID=-100xxxxxxxxxx        # "kids" birthdays post here
CORE_BOT_TOKEN=                    # r2D3 bot: send-only here, posts "core" birthdays (its code lives elsewhere)
CORE_CHAT_ID=-100xxxxxxxxxx       # "core" birthdays post here (the core friend group)
FOOTBALL_CHAT_ID=-100xxxxxxxxxx   # live final scores post here
# OUR_CHAT_ID=                    # legacy: used for either chat above if unset
FOLLOW_TEAMS=ALA,MICH,COLO,CSU
# RIVAL_TEAMS=OSU,AUB,LSU        # optional: gloat when these lose
KLIPY_KEY=                         # gif search, from https://partner.klipy.com/api-keys (Tenor API is dead)
STOCK_TOKEN=finnhub-key
UNSPLASH_KEY=
KYLES_KEY=
DB_PATH=./data/bot.sqlite          # message log; on fly.io this is /data/bot.sqlite (volume)
# BIRTHDAYS_PATH=./data/birthdays.json   # private birthday list; default sits next to DB_PATH (/data/birthdays.json on fly.io)
SCHEDULE_TZ=America/Denver         # timezone for the 9am game-day post, birthdays, Wrapped, and Wrapped stats
WRAPPED_PHRASES=roll tide,go blue,sko buffs,fun fact,bot quote
# WEBHOOK_URL=https://your-app.example.com   # optional: use webhooks instead of polling
# PORT=3000
